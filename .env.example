# Firebase Configuration for Samarth Kolhapur / Sahara Social Foundation
# Copy this file to .env and provide your Firebase credentials

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=sahara-social-foundation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sahara-social-foundation
VITE_FIREBASE_STORAGE_BUCKET=sahara-social-foundation.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

